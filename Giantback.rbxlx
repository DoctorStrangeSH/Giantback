  <Item class="ServerScriptService" referent="RBX128">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX129">
      <Properties>
        <string name="Name">World</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local Storage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local store
if not RunService:IsStudio() then
    store = game:GetService("DataStoreService"):GetDataStore("GiantbackAlbum_v1")
end
local event = Instance.new("RemoteEvent")
event.Name = "AlbumAction"
event.Parent = Storage
local giant = workspace.Mossback
local pets = {Fox = "Лисёнок-корешок", Moth = "Лунная моль"}
local progress = {"Fox", "Moth", "Seed", "Flower", "Timber", "Lantern", "Lit"}
local sessions = {}
local atDusk, sailing = false, false
local homePivot = giant:GetPivot()

local function tip(player, message)
    event:FireClient(player, message)
end

local function save(player)
    local session = sessions[player]
    if not session or not session.online then return end
    local snapshot = {}
    for _, key in progress do snapshot[key] = player:GetAttribute(key) == true end
    local ok, err = pcall(function()
        store:UpdateAsync(tostring(player.UserId), function(old)
            old = old or {}
            for _, key in progress do old[key] = old[key] or snapshot[key] end
            return old
        end)
    end)
    if not ok then warn("Album save:", err) end
end

local function init(player)
    if sessions[player] then return end
    local session = {}
    sessions[player] = session
    player.RespawnLocation = giant.HomeSpawn
    if not RunService:IsStudio() then
        local ok, data = pcall(function() return store:GetAsync(tostring(player.UserId)) end)
        if sessions[player] ~= session then return end
        session.online = ok
        if ok and type(data) == "table" then
            for _, key in progress do player:SetAttribute(key, data[key] == true) end
        end
        if not ok then player:SetAttribute("OfflineAlbum", true) end
    end
    player:SetAttribute("Ready", true)
end
Players.PlayerAdded:Connect(init)
for _, player in Players:GetPlayers() do task.spawn(init, player) end
Players.PlayerRemoving:Connect(function(player)
    save(player)
    sessions[player] = nil
end)
game:BindToClose(function()
    local pending = 0
    for _, player in Players:GetPlayers() do
        pending += 1
        task.spawn(function() save(player) pending -= 1 end)
    end
    while pending &gt; 0 do task.wait() end
end)
task.spawn(function()
    while task.wait(60) do
        for _, player in Players:GetPlayers() do task.spawn(save, player) end
    end
end)

local function prompt(part, title, verb, callback)
    local p = Instance.new("ProximityPrompt")
    p.ObjectText, p.ActionText = title, verb
    p.RequiresLineOfSight = false
    p.MaxActivationDistance = 9
    p.Parent = part
    p.Triggered:Connect(function(player)
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root and player:GetAttribute("Ready") and (root.Position-part.Position).Magnitude &lt;= 12 then
            callback(player)
        end
    end)
    return p
end

local function encounter(id, island, height)
    local nest = island.Nest
    local model = Storage[id]:Clone()
    model.Parent = island
    model:PivotTo(CFrame.new(nest.Position + Vector3.new(0,height,0)) * CFrame.Angles(0,math.pi,0))
    prompt(nest,pets[id],"Подружиться",function(player)
        player:SetAttribute(id,true)
        player:SetAttribute("Companion",id)
        tip(player,pets[id] .. " теперь с тобой!")
    end)
end
encounter("Fox",workspace.Grove,1.8)
encounter("Moth",workspace.Dusk,3.5)

event.OnServerEvent:Connect(function(player, action)
    if typeof(action) ~= "string" or not player:GetAttribute("Ready") then return end
    if pets[action] and player:GetAttribute(action) then player:SetAttribute("Companion",action) end
end)
prompt(workspace.Grove.Trail,"Следы в траве","Попросить лисёнка искать",function(player)
    if player:GetAttribute("Companion") ~= "Fox" then return tip(player,"Позови лисёнка из альбома.") end
    if player:GetAttribute("Seed") then return tip(player,"Семя уже найдено. Лунная моль поможет ему расцвести.") end
    player:SetAttribute("Seed",true)
    tip(player,"Лисёнок выкопал лунное семя! Отправляйся за молью.")
end)
prompt(giant.Planter,"Сад у дома","Разбудить цветок",function(player)
    if player:GetAttribute("Flower") then return tip(player,"Твой лунный цветок уже расцвёл.") end
    if not player:GetAttribute("Seed") then return tip(player,"Лисёнок чует семя на тропе возле гнезда.") end
    if player:GetAttribute("Companion") ~= "Moth" then return tip(player,"Позови лунную моль из альбома.") end
    player:SetAttribute("Flower",true)
    tip(player,"Моль расправила крылья. Твой первый лунный цветок расцвёл!")
end)

prompt(workspace.Grove.Driftwood,"Коряга на берегу","Искать сухие ветви",function(player)
    if not player:GetAttribute("Flower") then return tip(player,"Сначала вырасти лунный цветок у дома.") end
    if player:GetAttribute("Timber") then return tip(player,"Ветви уже собраны. Площадка рядом со штурвалом.") end
    if player:GetAttribute("Companion") ~= "Fox" then return tip(player,"Позови лисёнка. Он найдёт крепкие ветви.") end
    player:SetAttribute("Timber",true)
    tip(player,"Лисёнок нашёл ветви для садового фонаря!")
end)
prompt(giant.LanternBase,"Садовый фонарь","Осмотреть площадку",function(player)
    if not player:GetAttribute("Timber") then return tip(player,"После цветения возьми лисёнка к коряге в Солнечной роще.") end
    if not player:GetAttribute("Lantern") then
        player:SetAttribute("Lantern",true)
        return tip(player,"Фонарь построен! Позови моль, чтобы зажечь его.")
    end
    if player:GetAttribute("Lit") then return tip(player,"Фонарь освещает твой сад.") end
    if player:GetAttribute("Companion") ~= "Moth" then return tip(player,"Позови лунную моль из альбома.") end
    player:SetAttribute("Lit",true)
    tip(player,"Моль зажгла твой первый садовый фонарь!")
end)

local helm
helm = prompt(giant.Helm,"Мохоспин","К Лунной роще",function()
    if sailing then return end
    sailing = true
    helm.Enabled = false
    local origin = giant:GetPivot()
    local deck = giant.Meadow
    local riders = {}
    for _, player in Players:GetPlayers() do
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root and not root.Anchored then
            local pos = deck.CFrame:PointToObjectSpace(root.Position)
            if math.abs(pos.X) &lt;= 17 and math.abs(pos.Z) &lt;= 14 and pos.Y &gt;= 0 and pos.Y &lt; 20 then
                riders[root] = origin:ToObjectSpace(root.CFrame)
                root.Anchored = true
            end
        end
    end
    local target = homePivot + Vector3.new(atDusk and 0 or 100,0,0)
    local elapsed = 0
    while elapsed &lt; 5 do
        elapsed += RunService.Heartbeat:Wait()
        local t = math.min(elapsed/5,1)
        local frame = origin:Lerp(target,t*t*(3-2*t))
        giant:PivotTo(frame)
        for root, offset in riders do
            if root.Parent then root.CFrame = frame * offset end
        end
    end
    for root in riders do if root.Parent then root.Anchored = false end end
    atDusk = not atDusk
    helm.ActionText = atDusk and "К Солнечной роще" or "К Лунной роще"
    sailing = false
    helm.Enabled = true
end)

-- A shore-side call bell prevents riders left ashore from becoming stranded.
for _, island in {workspace.Grove,workspace.Dusk} do
    local bell = Instance.new("Part")
    bell.Name = "CallBell"
    bell.Anchored = true
    bell.Size = Vector3.new(2,3,2)
    bell.Color = Color3.fromRGB(237,185,101)
    bell.Position = island.Bank.Position + Vector3.new(5,6,-1+17)
    bell.Parent = island
    prompt(bell,"Дом на спине","Вернуться домой",function(player)
        if sailing then return tip(player,"Мохоспин в пути. Дождись прибытия.") end
        player.Character:PivotTo(giant.HomeSpawn.CFrame + Vector3.new(0,4,0))
    end)
end
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX130">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX131">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX132">
        <Properties>
          <string name="Name">Album</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local Storage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local event = Storage:WaitForChild("AlbumAction")
local gui = Instance.new("ScreenGui")
gui.Name = "GiantbackJournal"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local function card(kind, parent, text, pos, size)
    local c = Instance.new(kind)
    c.Position, c.Size = pos, size
    c.Text = text
    c.Font = Enum.Font.GothamMedium
    c.TextSize = 15
    c.TextWrapped = true
    c.TextColor3 = Color3.fromRGB(255,243,210)
    c.BackgroundColor3 = Color3.fromRGB(37,66,60)
    c.BackgroundTransparency = 0.08
    c.BorderSizePixel = 0
    Instance.new("UICorner",c).CornerRadius = UDim.new(0,10)
    c.Parent = parent
    return c
end
local status = card("TextLabel",gui,"",UDim2.fromOffset(10,8),UDim2.new(1,-115,0,56))
local limit = Instance.new("UISizeConstraint",status)
limit.MaxSize = Vector2.new(500,56)
local toggle = card("TextButton",gui,"Альбом",UDim2.new(1,-95,0,8),UDim2.fromOffset(85,48))
local panel = Instance.new("Frame")
panel.Position = UDim2.new(1,-242,0,69)
panel.Size = UDim2.fromOffset(232,132)
panel.BackgroundTransparency = 1
panel.Visible = false
panel.Parent = gui
toggle.Activated:Connect(function() panel.Visible = not panel.Visible end)
local rows = {}
local names = {Fox="Лисёнок-корешок",Moth="Лунная моль"}
for i,id in {"Fox","Moth"} do
    rows[id] = card("TextButton",panel,"",UDim2.fromOffset(0,(i-1)*60),UDim2.fromOffset(232,56))
    rows[id].Activated:Connect(function()
        if player:GetAttribute(id) then event:FireServer(id) end
    end)
end
local function goal()
    if not player:GetAttribute("Fox") then return "Перейди мостик в Солнечную рощу. У гнезда ждёт лисёнок." end
    if not player:GetAttribute("Seed") then return "Возьми лисёнка на тропу рядом с гнездом. Он чует семя!" end
    if not player:GetAttribute("Moth") then return "У штурвала плыви к Лунной роще. Найди моль у гнезда." end
    if not player:GetAttribute("Flower") then return "Позови моль и подойди к клумбе возле дома." end
    if not player:GetAttribute("Timber") then return "Возьми лисёнка к коряге в Солнечной роще за ветвями для фонаря." end
    if not player:GetAttribute("Lantern") then return "Построй фонарь на площадке рядом со штурвалом." end
    if not player:GetAttribute("Lit") then return "Позови моль и зажги садовый фонарь на площадке." end
    return "Садовый фонарь горит • Коллекция 2/2"
end
local lastTip = 0
local function refresh()
    for id,row in rows do
        local owned = player:GetAttribute(id)
        local equipped = player:GetAttribute("Companion") == id
        row.Text = names[id] .. "\n" .. (equipped and "✓ Рядом" or owned and "Позвать" or "Ещё не найден")
    end
    if os.clock() &gt;= lastTip then
        status.Text = (player:GetAttribute("OfflineAlbum") and "Без сохранения • " or "") .. goal()
    end
end
event.OnClientEvent:Connect(function(message)
    lastTip = os.clock()+3.5
    status.Text = message
    task.delay(3.6,refresh)
end)
player.AttributeChanged:Connect(refresh)
refresh()

local models = {}
local function follow(dt)
    for _, owner in Players:GetPlayers() do
        local root = owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
        local id = owner:GetAttribute("Companion")
        local model = models[owner]
        if model and (model.Name ~= id or not root) then
            model:Destroy()
            models[owner] = nil
            model = nil
        end
        if root and names[id] then
            local bob = math.sin(workspace:GetServerTimeNow()*3)*.22
            local target = root.CFrame * CFrame.new(2.8,(id=="Fox" and -1.6 or 1)+bob,2)
            if not model then
                model = Storage[id]:Clone()
                model:PivotTo(target)
                model.Parent = workspace
                models[owner] = model
            else
                model:PivotTo(model:GetPivot():Lerp(target,1-math.exp(-10*dt)))
            end
        end
    end
end
Players.PlayerRemoving:Connect(function(owner)
    if models[owner] then models[owner]:Destroy() models[owner] = nil end
end)
RunService.RenderStepped:Connect(follow)

local planter = workspace:WaitForChild("Mossback"):WaitForChild("Planter")
local flower
local function bloom()
    if flower or not player:GetAttribute("Flower") then return end
    flower = Instance.new("Model")
    flower.Name = "Moonflower"
    for i=0,6 do
        local petal = Instance.new("Part")
        petal.Anchored,petal.CanCollide = true,false
        petal.Shape = Enum.PartType.Ball
        petal.Size = i==0 and Vector3.new(1.1,1.1,1.1) or Vector3.new(1.45,.65,1.45)
        local angle = i*math.pi/3
        petal.Position = i==0 and Vector3.new(0,.35,0) or Vector3.new(math.cos(angle),0,math.sin(angle))
        petal.Color = i==0 and Color3.fromRGB(255,202,115) or Color3.fromRGB(216,173,246)
        petal.Material = Enum.Material.Neon
        petal.Parent = flower
    end
    flower.Parent = workspace
    local function placeFlower() flower:PivotTo(planter.CFrame * CFrame.new(0,1,0)) end
    placeFlower()
    planter:GetPropertyChangedSignal("CFrame"):Connect(placeFlower)
end
player:GetAttributeChangedSignal("Flower"):Connect(bloom)
bloom()

local base = workspace.Mossback:WaitForChild("LanternBase")
local lantern
local lamp
local light
local function updateLantern()
    if not player:GetAttribute("Lantern") then return end
    if not lantern then
        lantern = Instance.new("Model")
        lantern.Name = "GardenLantern"
        local function piece(name, height, size, color)
            local part = Instance.new("Part")
            part.Name = name
            part.Anchored = true
            part.CanCollide = false
            part.Size = size
            part.Color = color
            part.CFrame = base.CFrame * CFrame.new(0,height,0)
            part.Parent = lantern
            return part
        end
        local wood = Color3.fromRGB(129,87,62)
        local post = piece("Post",1.8,Vector3.new(.5,3,.5),wood)
        piece("Shelf",3.4,Vector3.new(1.7,.3,1.7),wood)
        lamp = piece("Glass",4.25,Vector3.new(1.3,1.45,1.3),Color3.fromRGB(242,198,127))
        piece("Cap",5.1,Vector3.new(1.85,.3,1.85),Color3.fromRGB(79,115,101))
        light = Instance.new("PointLight",lamp)
        light.Color = lamp.Color
        light.Range,light.Brightness = 16,2
        lantern.PrimaryPart = post
        lantern.Parent = workspace
        RunService.RenderStepped:Connect(function()
            local target = base.CFrame * CFrame.new(0,1.8,0)
            if post.CFrame ~= target then lantern:PivotTo(target) end
        end)
    end
    light.Enabled = player:GetAttribute("Lit") == true
    lamp.Material = light.Enabled and Enum.Material.Neon or Enum.Material.SmoothPlastic
end
player:GetAttributeChangedSignal("Lantern"):Connect(updateLantern)
player:GetAttributeChangedSignal("Lit"):Connect(updateLantern)
updateLantern()
</ProtectedString>
